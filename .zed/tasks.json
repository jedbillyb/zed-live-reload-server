// Live Reload tasks.
//
// Copy these into your own project's .zed/tasks.json, or into
// ~/.config/zed/tasks.json to have them everywhere.
//
// They drive the server the extension is already running, so they use your
// Zed settings and keep the unsaved-buffer mode working. Run one with
// `task: spawn`, or bind it to a key in ~/.config/zed/keymap.json:
//
//   [
//     {
//       "context": "Workspace",
//       "bindings": {
//         "cmd-alt-l": ["task::Spawn", { "task_name": "Live Reload: toggle" }],
//         "cmd-alt-o": ["task::Spawn", { "task_name": "Live Reload: open browser" }]
//       }
//     }
//   ]
//
// `hide: "on_success"` keeps the terminal panel from stealing focus, so a
// toggle is a single keystroke with no visible interruption.
[
  {
    "label": "Live Reload: toggle",
    "command": "live-reload-lsp",
    "args": ["toggle", "$ZED_WORKTREE_ROOT"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "never",
    "hide": "on_success"
  },
  {
    "label": "Live Reload: open browser",
    "command": "live-reload-lsp",
    "args": ["open", "$ZED_WORKTREE_ROOT"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "never",
    "hide": "on_success"
  },
  {
    "label": "Live Reload: status",
    "command": "live-reload-lsp",
    "args": ["status", "$ZED_WORKTREE_ROOT"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Live Reload: stop",
    "command": "live-reload-lsp",
    "args": ["stop", "$ZED_WORKTREE_ROOT"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "never",
    "hide": "on_success"
  }
]
